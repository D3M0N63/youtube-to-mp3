# ==============================================================================
# YOUTUBE TO MP3 - CONFIGURACIÓN DE ENTORNO (SIN API KEYS REQUERIDAS)
# ==============================================================================

# URL del backend Node.js + FFmpeg (dejar vacío cuando frontend y backend
# corren juntos en el mismo servidor o desarrollo local; definir con la URL de
# tu VPS Ubuntu si el frontend se despliega separado en Vercel).
NEXT_PUBLIC_BACKEND_URL=

# Ruta al binario local de FFmpeg en el servidor Ubuntu/Linux (por defecto: ffmpeg)
FFMPEG_PATH=ffmpeg

# Tiempo en segundos antes de eliminar automáticamente los archivos MP3 temporales
TEMP_FILE_TTL_SECONDS=300

# Límite de solicitudes por minuto por IP
RATE_LIMIT_RPM=20
