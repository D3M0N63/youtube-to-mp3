# ==============================================================================
# YOUTUBE TO MP3 - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# URL pública de la aplicación (usada para SEO, Open Graph, Sitemap y Robots.txt)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. YOUTUBE DATA API V3 (OPCIONAL - PARA DURACIÓN Y LICENCIA OFICIAL)
# ------------------------------------------------------------------------------
# La miniatura, el título y el canal se obtienen automáticamente sin clave mediante
# la API oficial pública YouTube oEmbed (https://www.youtube.com/oembed).
# Si configuras YOUTUBE_DATA_API_KEY (Google Cloud Console), el backend consultará
# además `googleapis.com/youtube/v3/videos` para obtener la duración exacta ISO-8601
# y el estado de licencia Creative Commons de cualquier video de YouTube.
YOUTUBE_DATA_API_KEY=

# ------------------------------------------------------------------------------
# 2. PROVEEDOR EXTERNO AUTORIZADO YOUTUBE-TO-MP3 (OPCIONAL)
# ------------------------------------------------------------------------------
# Para convertir cualquier video autorizado de YouTube que no posea un espejo
# público preexistente, configura el endpoint y API Key de tu microservicio
# o proveedor autorizado de conversión YouTube a MP3.
AUTHORIZED_YT_API_URL=
AUTHORIZED_YT_API_KEY=
AUTHORIZED_YT_API_HOST=

# ------------------------------------------------------------------------------
# 3. RECODIFICACIÓN DE BITRATE EN LA NUBE CON CLOUDCONVERT V2 (OPCIONAL)
# ------------------------------------------------------------------------------
# Si se define CLOUDCONVERT_API_KEY, el flujo de audio autorizado se recodifica
# exactamente a 128 kbps, 192 kbps o 320 kbps mediante CloudConvert API v2.
CLOUDCONVERT_API_KEY=
CLOUDCONVERT_SANDBOX=false

# ------------------------------------------------------------------------------
# 4. LÍMITES Y SEGURIDAD
# ------------------------------------------------------------------------------
MAX_AUDIO_SIZE_BYTES=157286400
RATE_LIMIT_RPM=25
